{
  "name": "@wakii/ui-kit",
  "version": "0.2.2",
  "description": "Design system của Wakii — tokens + Tailwind v4 + 90 React components + hooks (antd/PrimeReact parity), dark theme, motion. Storybook: https://storybook-static-khaki-two.vercel.app",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./carousel": "./src/entries/carousel.ts",
    "./chart": "./src/entries/chart.ts",
    "./schedule": "./src/entries/schedule.ts",
    "./editor": "./src/entries/editor.ts",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/base.css": "./src/styles/base.css",
    "./styles/tailwind.css": "./src/styles/tailwind.css",
    "./styles/themes/dark.css": "./src/styles/themes/dark.css",
    "./styles/ui-kit.css": "./dist/ui-kit.css"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsup && pnpm build:css",
    "storybook": "node scripts/stamp-build.cjs && storybook dev -p 6006",
    "build-storybook": "node scripts/stamp-build.cjs && storybook build",
    "test-storybook": "test-storybook --maxWorkers=2",
    "build:css": "tailwindcss -i src/styles/ui-kit.css -o dist/ui-kit.css --minify"
  },
  "peerDependencies": {
    "@fullcalendar/core": "^6.1.15",
    "@tiptap/react": "^3.32.0",
    "chart.js": "^4.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "swiper": "^14.3.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "swiper": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    },
    "@fullcalendar/core": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./carousel": {
        "types": "./dist/carousel.d.ts",
        "import": "./dist/carousel.js",
        "require": "./dist/carousel.cjs"
      },
      "./chart": {
        "types": "./dist/chart.d.ts",
        "import": "./dist/chart.js",
        "require": "./dist/chart.cjs"
      },
      "./schedule": {
        "types": "./dist/schedule.d.ts",
        "import": "./dist/schedule.js",
        "require": "./dist/schedule.cjs"
      },
      "./editor": {
        "types": "./dist/editor.d.ts",
        "import": "./dist/editor.js",
        "require": "./dist/editor.cjs"
      },
      "./styles/tokens.css": "./src/styles/tokens.css",
      "./styles/base.css": "./src/styles/base.css",
      "./styles/tailwind.css": "./src/styles/tailwind.css",
      "./styles/themes/dark.css": "./src/styles/themes/dark.css"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@hookform/resolvers": "^5.9.2",
    "@storybook/addon-a11y": "^9.1.21",
    "@storybook/addon-docs": "^9.0.0",
    "@storybook/addon-themes": "^9.1.21",
    "@storybook/react-vite": "^9.0.0",
    "@storybook/test-runner": "^0.26.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "6.9.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "3.2.4",
    "chart.js": "^4.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "27.0.0",
    "motion": "^12",
    "playwright": "^1.64.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7",
    "storybook": "^9.0.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.0.0",
    "vitest": "3.2.4",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "swiper": "^14.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wakii-dev/architecture-overview.git",
    "directory": "app/ui-kit"
  },
  "homepage": "https://storybook-static-khaki-two.vercel.app",
  "bugs": "https://github.com/wakii-dev/architecture-overview/issues",
  "keywords": [
    "design-system",
    "ui-kit",
    "react",
    "tailwind",
    "components",
    "antd",
    "primereact",
    "wakii"
  ],
  "author": "wakii-dev",
  "license": "MIT"
}
