{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    // fe-shared src/ui (SF-1) import 'react' nhưng package không khai báo dep (giữ
    // pnpm-lock.yaml) — TS map types về node_modules của consumer (đối xứng với
    // resolve.modules trong rspack.config.mjs / alias trong vitest.config.ts)
    "baseUrl": ".",
    "paths": {
      "react": ["node_modules/@types/react"],
      "react/jsx-runtime": ["node_modules/@types/react/jsx-runtime"]
    }
  },
  "include": ["src", "tests", "rspack.config.mjs", "vitest.config.ts"]
}
