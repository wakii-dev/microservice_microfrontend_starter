{
  "name": "@wakii/ui-kit",
  "version": "0.1.0",
  "private": true,
  "description": "ui-kit — design system của boilerplate: tokens + base css + primitives (Badge/EmptyState/Skeleton/Spinner, SF-1 story VU-53). Tách khỏi fe-shared 2026-10-17 (ADR-0009): design system ≠ logic, SF design-system không đụng vùng READ-LOCKED của fe-shared. Consumed QUA SOURCE — main/types trỏ thẳng src/, KHÔNG build, KHÔNG runtime dep (react types do consumer cung cấp — tsconfig paths/resolve.modules của consumer; devDeps react chỉ để chạy test + storybook).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/base.css": "./src/styles/base.css",
    "./styles/tailwind.css": "./src/styles/tailwind.css"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.0.0",
    "@storybook/react-vite": "^9.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "6.9.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "3.2.4",
    "antd": "^6.6.6",
    "jsdom": "27.0.0",
    "motion": "^12",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "^9.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
