# ============================================================================
# Complete env inventory — the single source of truth for compose + services config.
# Usage: cp .env.example .env then fill in real values. .env is NOT committed.
# Rule: a new env var = add it here in the same commit (platform/conventions/06).
# ============================================================================

# --- Shared ---
# Secret that signs + verifies JWT HS256 (contracts/auth/token-contract.md). MUST be changed before use.
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-openssl-rand-base64-48

# Log level for every service: debug | info | warn | error
LOG_LEVEL=info

# --- Ports (platform/conventions/05-ports.md) ---
# ⚠️ The *_PORT vars only change the HOST-side port (access from a dev machine); the port INSIDE
# the compose network stays fixed by the table — container ports are hardcoded in compose.
GATEWAY_PORT=8080
SHELL_PORT=3000
REMOTE_TASKS_PORT=4001
REMOTE_ACTIVITY_PORT=4002
NODE_SVC_PORT=3001
SPRING_SVC_PORT=8081
GO_SVC_PORT=8082
DOTNET_SVC_PORT=8083
AUTH_PORT=8090
POSTGRES_PORT=5432

# --- Postgres ---
POSTGRES_USER=boilerplate
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=boilerplate

# Per-service DB role password (created by platform/postgres/init/01-init.sh)
NODE_SVC_DB_PASSWORD=change-me-node
SPRING_SVC_DB_PASSWORD=change-me-spring
GO_SVC_DB_PASSWORD=change-me-go
GO_READONLY_DB_PASSWORD=change-me-goreadonly
AUTH_SVC_DB_PASSWORD=change-me-auth
DOTNET_SVC_DB_PASSWORD=change-me-dotnet

# Password of the fixture service user `svc-activity` (users.json) — go-svc logs in to
# auth to get a service token for the resolver (conventions/09). MUST match
# AUTH_DEV_PASSWORD (auth-svc compares the seeded users' password hash — token-contract.md §5).
SVC_ACTIVITY_PASSWORD=demo-password

# --- Kafka (conventions/09, ADR-0008) ---
# Bootstrap servers. Inside the compose network = the service name `kafka:9092` (9092 is NOT
# exposed to the host). Native dev outside compose overrides it to localhost:9092.
KAFKA_BROKERS=kafka:9092

# --- Inter-service URLs (inside the compose network use service names) ---
NODE_SVC_URL=http://node-svc:3001
SPRING_SVC_URL=http://spring-svc:8081
GO_SVC_URL=http://go-svc:8082
# KEY stays AUTH_MOCK_URL (go-svc reads this exact env name — gap-answer ④ epic VU-59);
# VALUE points to auth-svc (renaming the KEY = a follow-up of the iss-rename cluster).
AUTH_MOCK_URL=http://auth-svc:8090
SHELL_URL=http://shell:3000
REMOTE_TASKS_URL=http://remote-tasks:4001
REMOTE_ACTIVITY_URL=http://remote-activity:4002

# --- FE (dev, outside compose) ---
# Origins allowed for CORS during native dev (platform/conventions/07-cors.md)
CORS_DEV_ORIGIN=http://localhost:3000,http://localhost:4001,http://localhost:4002

# --- auth (AUTH_MOCK_* → AUTH_* rename completed in SF-5 VU-64 — compose already swapped) ---
# Dev password for the SEEDED fixture users (users.json — token-contract.md §5).
# Keep the demo-password default UNCHANGED: e2e + svc-activity + seed share one source.
AUTH_DEV_PASSWORD=demo-password
# Access-token JWT TTL (auth-svc — token-contract.md §1)
ACCESS_TOKEN_TTL=30m
# Path of the users fixture inside the container
USERS_FIXTURE_PATH=/app/users.json
