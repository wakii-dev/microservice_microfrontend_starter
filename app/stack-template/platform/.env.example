# ============================================================================
# Env inventory ĐẦY ĐỦ — nguồn sự duy nhất về cấu hình compose + services.
# Cách dùng: cp .env.example .env rồi điền giá trị thật. .env KHÔNG commit.
# Quy tắc: thêm env var mới = thêm vào đây cùng commit (platform/conventions/06).
# ============================================================================

# --- Shared ---
# Secret ký + verify JWT HS256 (contracts/auth/token-contract.md). BẮT BUỘC đổi khi dùng.
# Sinh: openssl rand -base64 48
JWT_SECRET=change-me-openssl-rand-base64-48

# Log level mọi service: debug | info | warn | error
LOG_LEVEL=info

# --- Ports (platform/conventions/05-ports.md) ---
# ⚠️ Các biến *_PORT chỉ đổi port side HOST (truy cập từ máy dev); port TRONG
# mạng compose cố định theo bảng — container port hardcode trong compose.
GATEWAY_PORT=8080
SHELL_PORT=3000
REMOTE_TASKS_PORT=4001
REMOTE_ACTIVITY_PORT=4002
NODE_SVC_PORT=3001
SPRING_SVC_PORT=8081
GO_SVC_PORT=8082
DOTNET_SVC_PORT=8083
AUTH_PORT=8090
POSTGRES_PORT=5432

# --- Postgres ---
POSTGRES_USER=boilerplate
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=boilerplate

# Password per-service DB role (tạo bởi platform/postgres/init/01-init.sh)
NODE_SVC_DB_PASSWORD=change-me-node
SPRING_SVC_DB_PASSWORD=change-me-spring
GO_SVC_DB_PASSWORD=change-me-go
GO_READONLY_DB_PASSWORD=change-me-goreadonly
AUTH_SVC_DB_PASSWORD=change-me-auth
DOTNET_SVC_DB_PASSWORD=change-me-dotnet

# Password service user `svc-activity` (fixture users.json) — go-svc login
# auth lấy service token cho resolver (conventions/09). BẮT BUỘC khớp
# AUTH_DEV_PASSWORD (auth-svc so password hash của seeded users — token-contract.md §5).
SVC_ACTIVITY_PASSWORD=demo-password

# --- Kafka (conventions/09, ADR-0008) ---
# Bootstrap servers. Trong mạng compose = tên service `kafka:9092` (9092 KHÔNG
# expose ra host). Native dev ngoài compose override thành localhost:9092.
KAFKA_BROKERS=kafka:9092

# --- URLs inter-service (trong mạng compose dùng tên service) ---
NODE_SVC_URL=http://node-svc:3001
SPRING_SVC_URL=http://spring-svc:8081
GO_SVC_URL=http://go-svc:8082
# KEY giữ AUTH_MOCK_URL (go-svc đọc theo tên env này — gap-answer ④ epic VU-59);
# VALUE trỏ auth-svc (đổi KEY = follow-up cụm iss-rename).
AUTH_MOCK_URL=http://auth-svc:8090
SHELL_URL=http://shell:3000
REMOTE_TASKS_URL=http://remote-tasks:4001
REMOTE_ACTIVITY_URL=http://remote-activity:4002

# --- FE (dev, ngoài compose) ---
# Origin được phép CORS khi chạy native dev (platform/conventions/07-cors.md)
CORS_DEV_ORIGIN=http://localhost:3000,http://localhost:4001,http://localhost:4002

# --- auth (rename AUTH_MOCK_* → AUTH_* hoàn tất SF-5 VU-64 — compose đã swap) ---
# Dev password cho SEEDED fixture users (users.json — token-contract.md §5).
# Default demo-password KHÔNG ĐỔI: e2e + svc-activity + seed cùng một nguồn.
AUTH_DEV_PASSWORD=demo-password
# TTL access token JWT (auth-svc — token-contract.md §1)
ACCESS_TOKEN_TTL=30m
# Đường dẫn users fixture trong container
USERS_FIXTURE_PATH=/app/users.json
